# このファイルをコピーして「.env」という名前で作り、値を入れてください。
# （LinkedIn開発者サイト > 自分のアプリ > Authタブで確認）
LINKEDIN_CLIENT_ID=ここにクライアントID
LINKEDIN_CLIENT_SECRET=ここにクライアントシークレット

# ログイン後にLinkedInが戻ってくるURL。アプリ設定のRedirect URLと完全に同じでなければいけません。
REDIRECT_URI=http://localhost:3000/callback

# LinkedIn APIのバージョン（YYYYMM形式）。古くなると止まるので、エラーが出たら最新の月に変えてみてください。
LINKEDIN_VERSION=202608
