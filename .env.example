# 이 파일을 복사해서 ".env" 라는 이름으로 만들고 값을 채우세요.
# (LinkedIn 개발자 사이트 > 내 앱 > Auth 탭에서 확인)
LINKEDIN_CLIENT_ID=여기에_클라이언트_ID
LINKEDIN_CLIENT_SECRET=여기에_클라이언트_시크릿

# 로그인 후 링크드인이 돌아올 주소. 앱 설정의 Redirect URL(되돌아오기 주소)과 똑같아야 해요.
REDIRECT_URI=http://localhost:3000/callback

# 링크드인 API 버전(YYYYMM 형식). 오래되면 막히니, 에러가 나면 최신 달로 바꿔보세요.
LINKEDIN_VERSION=202608
